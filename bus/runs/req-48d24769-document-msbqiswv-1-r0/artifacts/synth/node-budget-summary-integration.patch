+test('readNodeStatuses は optional budget の有無で旧ビュー射影を変えない', () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kpv-nodes-budget-'));
+  try {
+    const sdir = path.join(tmp, 'status');
+    fs.mkdirSync(sdir, { recursive: true });
+    const file = path.join(sdir, 'pc-a.json');
+    const status = {
+      node: 'pc-a', host: 'h1', updated_iso: new Date(Date.now() - 10000).toISOString(),
+      fresh_after_sec: 120, paused: false, watch: true, level: 'unattended',
+    };
+    fs.writeFileSync(file, JSON.stringify(status));
+    const withoutBudget = project.readNodeStatuses(tmp);
+    fs.writeFileSync(file, JSON.stringify({ ...status, budget: {
+      can_accept: false, exceeded: true, soft: false, on_exhausted: 'pause',
+      spent_min: 120, limit_min: 120, spent_tokens: 500000,
+      token_limit: 500000, period: 'day',
+    } }));
+    assert.deepStrictEqual(project.readNodeStatuses(tmp), withoutBudget);
+  } finally {
+    fs.rmSync(tmp, { recursive: true, force: true });
+  }
+});

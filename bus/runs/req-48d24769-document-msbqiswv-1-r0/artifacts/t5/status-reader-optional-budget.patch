+    def test_peer_reader_ignores_optional_budget(self):
+        # budget は additive。旧 reader の射影は有無に左右されない。
+        with tempfile.TemporaryDirectory() as d:
+            d = Path(d)
+            cfg = cfg_for(d, node="pc-a")
+            mk_peer(d, "pc-budget", availability="active")
+            expected = km._peer_nodes(cfg)
+
+            path = d / "status" / "pc-budget.json"
+            record = json.loads(path.read_text(encoding="utf-8"))
+            record["budget"] = {"can_accept": True}
+            path.write_text(
+                json.dumps(record, ensure_ascii=False), encoding="utf-8")
+
+            self.assertEqual(expected, {"pc-budget"})
+            self.assertEqual(km._peer_nodes(cfg), expected)
+
